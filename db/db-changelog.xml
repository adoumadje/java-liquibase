<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.8.xsd">

    <changeSet id="create table BREEDS on dating db" author="caleb">
        <createTable tableName="BREEDS">
            <column name="BRE_ID" type="int" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_BREEDS" />
            </column>
            <column name="BRE_NAME" type="varchar(100)">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="insert 3 breeds" author="Caleb">
        <insert tableName="BREEDS">
            <column name="BRE_NAME" value="Golden Retriever" />
        </insert>
        <insert tableName="BREEDS">
            <column name="BRE_NAME" value="American Staffordshire Terrier" />
        </insert>
        <insert tableName="BREEDS">
            <column name="BRE_NAME" value="German Shepherd Doger" />
        </insert>
    </changeSet>
    
    <changeSet id="create PROFILES table" author="Caleb">
        <createTable tableName="PROFILES">
            <column name="PRO_ID" type="int" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PROFILES" />
            </column>
            <column name="PRO_NAME" type="varchar(100)">
                <constraints nullable="false" />
            </column>
            <column name="PRO_BRE_ID" type="int(11)" defaultValue="null" />
            <column name="PRO_HEIGHT" type="int(11)" defaultValue="null" />
            <column name="PRO_WEIGHT" type="int(11)" defaultValue="null" />
            <column name="PRO_DESCRIPTION" type="varchar(4000)" defaultValue="null" />
            <column name="PRO_IMAGE_URL" type="varchar(100)" defaultValue="null" />
        </createTable>
    </changeSet>

    <changeSet id="create INDEX on PROFILES" author="Caleb">
        <createIndex tableName="PROFILES" indexName="IDX_PRO_BRE_ID">
            <column name="PRO_BRE_ID" />
        </createIndex>
    </changeSet>

    <changeSet id="alter PROFILES to add foreign key to BREEDS" author="Caleb">
        <addForeignKeyConstraint baseTableName="PROFILES" baseColumnNames="PRO_BRE_ID" constraintName="FK_PRO_BRE_ID" referencedTableName="BREEDS"
                                 referencedColumnNames="BRE_ID" />
    </changeSet>

</databaseChangeLog>